  "patterns": [
    {
      "id": "identity",
      "shape": "Name the project, its type, and its primary purpose in one sentence.",
      "required": ["project", "type", "purpose"]
    },
    {
      "id": "task-section",
      "shape": "Use a user task as the heading, then give prerequisites, the command, and its observable result.",
      "required": ["task", "prerequisite", "action", "result"]
    },
    {
      "id": "constraint",
      "shape": "State the supported version or environment before the instruction that depends on it.",
      "required": ["constraint", "dependent action"]
    },
    {
      "id": "reference-route",
      "shape": "Keep the common path in the README and link detailed or uncommon cases to maintained documentation.",
      "required": ["common path", "reference target"]
    },
    {
      "id": "contribution",
      "shape": "Name the accepted contribution path and link its rules without restating the complete guide.",
      "required": ["contribution path", "rules link"]
    }
  ],
  "professional_patterns": [
    {
      "id": "sentence-grammar",
      "shape": "Keep the subject and predicate explicit, place modifiers beside their target, and replace ambiguous pronouns with the exact noun.",
      "required": ["subject", "predicate", "modifier target"]
    },
    {
      "id": "definition",
      "shape": "Define a term by naming its category and the property that distinguishes it in this context.",
      "required": ["term", "category", "distinguishing property"]
    },
    {
      "id": "claim-evidence",
      "shape": "State one claim, give the evidence or verified reason, then state only the consequence supported by it.",
      "required": ["claim", "evidence or reason", "supported consequence"]
    },
    {
      "id": "qualified-claim",
      "shape": "Place the applicable version, environment, assumption, or exception before the claim it limits.",
      "required": ["scope or condition", "claim"]
    },
    {
      "id": "comparison",
      "shape": "Compare alternatives on the same named dimensions and support each conclusion with observable evidence.",
      "required": ["alternatives", "shared dimensions", "evidence"]
    },
    {
      "id": "parallel-structure",
      "shape": "Give headings and items in one list the same grammatical role and comparable level of detail.",
      "required": ["shared grammatical role", "comparable scope"]
    },
    {
      "id": "procedure",
      "shape": "Give prerequisites, ordered actions, expected results, and recovery only for failures the reader can encounter.",
      "required": ["prerequisites", "actions", "expected results"]
    },
    {
      "id": "fact-boundary",
      "shape": "Label sourced facts, observations, inferences, decisions, and recommendations as different statement types.",
      "required": ["statement type", "basis"]
    }
  ]
}
