  "patterns": [
    {
      "id": "action-label",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "nextcloud-2019",
        "mastodon-2019",
        "gnome-control-center-2019",
        "vscode-2019"
      ],
      "surface": "button or menu item",
      "shape": "Use a direct verb, adding the object only when nearby context does not identify it.",
      "required": ["action", "unambiguous object"]
    },
    {
      "id": "field-label",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "gnome-control-center-2019",
        "vscode-2019"
      ],
      "surface": "field, tab, column, or section label",
      "shape": "Use a noun phrase without a sentence ending or explanatory clause.",
      "required": ["field or subject name"]
    },
    {
      "id": "placeholder",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "discourse-2019",
        "vscode-2019"
      ],
      "surface": "input placeholder",
      "shape": "Name the expected value or format; put persistent constraints in help text.",
      "required": ["expected input"]
    },
    {
      "id": "progress",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "nextcloud-2019",
        "discourse-2019",
        "vscode-2019"
      ],
      "surface": "pending or loading state",
      "shape": "Use either `正在<操作>…` or `<操作>中`, with the locale term for the operation, but do not combine both aspect markers.",
      "required": ["ongoing operation"]
    },
    {
      "id": "success",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "nextcloud-2019",
        "mastodon-2019",
        "discourse-2019"
      ],
      "surface": "success message or toast",
      "shape": "State the completed operation and object; do not reuse the control label as the result message.",
      "required": ["completed operation", "object"]
    },
    {
      "id": "failure",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "nextcloud-2019",
        "gnome-control-center-2019",
        "vscode-2019"
      ],
      "surface": "error message",
      "shape": "State what could not be completed, then add a verified cause and available recovery action.",
      "required": ["failed operation", "affected object"]
    },
    {
      "id": "validation",
      "origin": "corpus",
      "evidence": [
        "nextcloud-2019",
        "discourse-2019",
        "gnome-control-center-2019"
      ],
      "surface": "field validation",
      "shape": "State the exact missing value, accepted form, range, or conflict beside the field.",
      "required": ["invalid condition", "acceptance condition"]
    },
    {
      "id": "empty-state",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "discourse-2019",
        "gnome-control-center-2019"
      ],
      "surface": "empty or zero-result state",
      "shape": "Distinguish no data from no matching result and offer only an action that is actually available.",
      "required": ["empty-state cause", "available next action"]
    },
    {
      "id": "confirmation",
      "origin": "corpus",
      "evidence": [
        "nextcloud-2019",
        "mastodon-2019",
        "discourse-2019",
        "vscode-2019"
      ],
      "surface": "confirmation dialog",
      "shape": "Name the action, object, irreversible effect, and safer alternative when one exists.",
      "required": ["action", "object", "effect"]
    },
    {
      "id": "accessible-name",
      "origin": "corpus",
      "evidence": [
        "grafana-2022",
        "gnome-control-center-2019",
        "vscode-2019"
      ],
      "surface": "accessible label or tooltip",
      "shape": "Name the control action or current state without visual position, icon shape, or redundant control type.",
      "required": ["action or state"]
    }
  ]
